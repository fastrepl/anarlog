# Maintainer: Anarlog <support@anarlog.so>
pkgname=anarlog-bin
pkgver=1.4.11
pkgrel=1
pkgdesc="AI notepad for meetings — local-first, E2EE desktop note-taking app"
arch=('x86_64' 'aarch64')
url="https://anarlog.so"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libpipewire'
  'libpulse'
  'alsa-lib'
  'openssl'
  'gcc-libs'
  'ca-certificates'
  'desktop-file-utils'
  'xdg-utils'
  'hicolor-icon-theme'
)
optdepends=(
  'libayatana-appindicator: tray icon support'
  'pipewire: audio capture at runtime'
)
provides=('anarlog')
conflicts=('anarlog')
options=('!strip')
_release="desktop_v${pkgver}"
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/fastrepl/anarlog/${_release}/LICENSE")
source_x86_64=("anarlog-${pkgver}-x86_64.deb::https://github.com/fastrepl/anarlog/releases/download/${_release}/anarlog-linux-x86_64.deb")
source_aarch64=("anarlog-${pkgver}-aarch64.deb::https://github.com/fastrepl/anarlog/releases/download/${_release}/anarlog-linux-aarch64.deb")
sha256sums=('ba9cc3a7e074c5cfe3985d6956f24c9f7575592a0483e314c9fcb4f72ee1b615')
sha256sums_x86_64=('e573988792ec52e15126de55b0aafa53ee8ea99dab5664c2a7e500be232210db')
sha256sums_aarch64=('702692ef4a5a367b6561f443a90150effb8b97d4b21785bf29a113aa8a284802')

package() {
  tar -xzf data.tar.gz -C "$pkgdir"
  chmod -R u+rwX,go+rX,go-w "$pkgdir/usr"
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
