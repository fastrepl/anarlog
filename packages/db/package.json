{
  "name": "@hypr/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    }
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@hypr/db-runtime": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.3",
    "typescript": "~5.8.3",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "introspect": "drizzle-kit introspect",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
