POSTGRES_DB=anarlog
POSTGRES_USER=anarlog
POSTGRES_PASSWORD=replace-with-random-hex
ANARLOG_ENTERPRISE_DATABASE_URL=postgres://anarlog:replace-with-random-hex@postgres:5432/anarlog
ANARLOG_ENTERPRISE_DATABASE_MAX_CONNECTIONS=10
ANARLOG_ENTERPRISE_WORKSPACE_TOKENS={"evaluation-workspace":"replace-with-at-least-32-random-characters"}
