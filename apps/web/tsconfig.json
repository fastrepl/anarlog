{
  "include": [
    "src/router.tsx",
    "src/routeTree.gen.ts",
    "src/start.ts",
    "src/routes/**/*.tsx",
    "src/lib/brand-noise.ts",
    "src/lib/seo.ts",
    "src/scripts/versioning.ts",
    "src/utils/sitemap.ts",
    "content-collections.ts",
    "vite.config.ts"
  ],
  "exclude": ["**/supabase/functions/**/*", "**/netlify/**/*"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "content-collections": ["./.content-collections/generated"]
    }
  }
}
