{
  "name": "@anlg/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' VITE_APP_URL=\"http://localhost:3000\" VITE_API_URL=\"http://localhost:3001\" dotenvx run --ignore MISSING_ENV_FILE -f ../../.env.supabase -f .env -- vite dev --port 3000",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' vite build && cp public/sitemap.xml dist/client/sitemap.xml && pagefind --site ./dist/client",
    "media:napkin": "node scripts/napkin-to-public.mjs",
    "media:figures": "node scripts/napkin-batch.mjs",
    "media:figures:check": "node scripts/napkin-batch.mjs --check && node scripts/static-media-check.mjs",
    "deploy:workspace-share-router": "wrangler deploy --config wrangler.workspace-share.jsonc",
    "serve": "vite preview",
    "test": "node --test",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anlg/api-client": "workspace:*",
    "@anlg/changelog": "workspace:^",
    "@anlg/editor": "workspace:*",
    "@anlg/pricing": "workspace:^",
    "@anlg/supabase": "workspace:*",
    "@anlg/ui": "workspace:*",
    "@anlg/user-error": "workspace:*",
    "@anlg/utils": "workspace:*",
    "@floating-ui/dom": "^1.7.6",
    "@honeycombio/opentelemetry-web": "^1.3.0",
    "@iconify-icon/react": "^3.0.3",
    "@nangohq/frontend": "^0.69.48",
    "@netlify/cache": "^3.4.4",
    "@netlify/vite-plugin-tanstack-start": "^1.3.3",
    "@opentelemetry/auto-instrumentations-web": "^0.49.1",
    "@sentry/tanstackstart-react": "^10.48.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.103.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.168.19",
    "@tanstack/react-router-ssr-query": "^1.166.11",
    "@tanstack/react-start": "^1.167.33",
    "@unpic/react": "^1.0.2",
    "jwt-decode": "^4.0.0",
    "mdx-mermaid": "^2.0.3",
    "mermaid": "^11.16.1",
    "motion": "^11.18.2",
    "posthog-js": "^1.367.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-tweet": "^3.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "streamdown": "^2.5.0",
    "stripe": "^20.4.1",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.2.2",
    "unpic": "^4.2.2",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@content-collections/core": "^0.15.0",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/vite": "^0.3.0",
    "@dotenvx/dotenvx": "^1.61.0",
    "@sentry/cli": "^3.6.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "js-yaml": "^4.3.1",
    "jsdom": "^27.4.0",
    "netlify": "^23.15.1",
    "pagefind": "^1.5.2",
    "tanstack-router-sitemap": "^1.0.13",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "wrangler": "4.129.0"
  }
}
