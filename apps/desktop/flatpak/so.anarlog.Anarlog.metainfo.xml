<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>so.anarlog.Anarlog</id>

  <name>Anarlog</name>
  <summary>The AI notepad for private meetings</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Anarlog is a private meeting notepad that records microphone and computer
      audio, transcribes conversations, and keeps notes alongside the transcript.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Bot-free microphone and computer-audio capture</li>
      <li>Live transcription with notes in the same workspace</li>
      <li>AI summaries and follow-up chat</li>
      <li>Local and bring-your-own-provider workflows</li>
      <li>Reusable note templates</li>
    </ul>
  </description>

  <launchable type="desktop-id">so.anarlog.Anarlog.desktop</launchable>

  <url type="homepage">https://anarlog.so</url>
  <url type="bugtracker">https://github.com/fastrepl/anarlog/issues</url>
  <url type="vcs-browser">https://github.com/fastrepl/anarlog</url>
  <url type="contribute">https://github.com/fastrepl/anarlog/blob/main/CONTRIBUTING.md</url>

  <developer id="com.fastrepl">
    <name>Fastrepl</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#f5f5f5</color>
    <color type="primary" scheme_preference="dark">#1a1a1a</color>
  </branding>

  <content_rating type="oars-1.1" />

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <categories>
    <category>Office</category>
  </categories>

  <keywords>
    <keyword>notes</keyword>
    <keyword>meeting</keyword>
    <keyword>transcription</keyword>
    <keyword>audio</keyword>
    <keyword>recording</keyword>
    <keyword>speech-to-text</keyword>
  </keywords>

  <screenshots>
