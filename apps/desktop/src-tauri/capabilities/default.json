{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-center",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-is-maximized",
    "core:window:allow-toggle-maximize",
    "core:window:allow-set-theme",
    "calendar:default",
    "audio-priority:default",
    "auth:default",
    "db:default",
    "db:allow-begin-cloudsync-activity",
    "db:allow-end-cloudsync-activity",
    "db:allow-sync-cloudsync-now",
    "windows:default",
    "windows:allow-floating-bar-show",
    "windows:allow-floating-bar-hide",
    "windows:allow-floating-bar-update",
    "windows:allow-floating-bar-update-amplitude",
    "windows:allow-floating-bar-current-state",
    "windows:allow-live-caption-current-state",
    "windows:allow-devtools-panel-show",
    "windows:allow-devtools-panel-hide",
    "tracing:default",
    "anlg-tray:default",
    "analytics:default",
    "attachment-sync:default",
    "agent:default",
    "bedrock:default",
    "updater:default",
    "updater2:default",
    "deeplink2:default",
    "store:default",
    "store2:default",
    "process:default",
    "local-llm:default",
    "local-stt:default",
    "dialog:default",
    "hooks:default",
    "icon:default",
    "importer:default",
    "transcription:default",
    "template:default",
    "todo:default",
    "notification:default",
    "overlay:default",
    "notify:default",
    "tantivy:default",
    "clipboard-manager:allow-write-image",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "shell:allow-open",
    "misc:default",
    "fs-sync:default",
    "fs2:default",
    "git:default",
    "os:default",
    "os:allow-hostname",
    "opener2:default",
    "mcp:default",
    "messenger:default",
    "detect:default",
    "dock:default",
    "permissions:default",
    "screen:default",
    "settings:default",
    "sfx:default",
    "path2:default",
    "export:default",
    "autostart:default",
    "js:default",
    "local-api:default",
    "local-auth:default",
    "relay:default",
    "shortcut:default",
    "dictation:default",
    {
      "identifier": "http:default",
      "deny": [],
      "allow": [
        {
          "url": "http://localhost:*/**"
        },
        {
          "url": "http://*.*.*.*:*/**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ]
    }
  ]
}
