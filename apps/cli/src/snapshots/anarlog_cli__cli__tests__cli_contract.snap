---
source: apps/cli/src/cli.rs
expression: canonicalize_json(contract)
---
{
  "about": "Access Anarlog from the command line",
  "global_options": [
    {
      "flags": "--base",
      "is_flag": false,
      "required": false,
      "value_name": "DIR"
    },
    {
      "flags": "--db-path",
      "is_flag": false,
      "required": false,
      "value_name": "FILE"
    },
    {
      "flags": "--json",
      "is_flag": true,
      "required": false
    }
  ],
  "name": "anarlog",
  "options": [
    {
      "flags": "-h, --help",
      "help": "Print help",
      "is_flag": false,
      "required": false
    },
    {
      "flags": "-V, --version",
      "help": "Print version",
      "is_flag": false,
      "required": false
    }
  ],
  "subcommands": [
    {
      "about": "Sign in to an Anarlog account from a browser",
      "name": "anarlog auth",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "subcommands": [
        {
          "about": "Sign in through a browser on this or another device",
          "name": "anarlog auth login",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog auth login [-h]"
        },
        {
          "about": "Show the locally stored account session",
          "name": "anarlog auth status",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog auth status [-h]"
        },
        {
          "about": "Remove the locally stored account session",
          "name": "anarlog auth logout",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog auth logout [-h]"
        }
      ],
      "synopsis": "anarlog auth [-h] <command>"
    },
    {
      "about": "Check the local CLI and database connection without changing data",
      "name": "anarlog doctor",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "synopsis": "anarlog doctor [-h]"
    },
    {
      "about": "Browse and export meetings",
      "name": "anarlog meetings",
      "options": [
        {
          "default": "local",
          "flags": "--source",
          "help": "Choose local data, hosted Cloud snapshots, or Cloud only when no local database exists",
          "is_flag": false,
          "possible_values": [
            "local",
            "cloud",
            "auto"
          ],
          "required": false,
          "value_name": "SOURCE"
        },
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "subcommands": [
        {
          "about": "Read local capture intervals without meeting content or identifiers",
          "name": "anarlog meetings pilot-usage",
          "options": [
            {
              "flags": "--from-ms",
              "is_flag": false,
              "required": true,
              "value_name": "FROM_MS"
            },
            {
              "flags": "--until-ms",
              "is_flag": false,
              "required": true,
              "value_name": "UNTIL_MS"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings pilot-usage <--from-ms> <--until-ms> [-h]"
        },
        {
          "about": "List all persisted local meetings for preservation, including deleted rows",
          "name": "anarlog meetings hold-list",
          "options": [
            {
              "default": "",
              "flags": "--after",
              "is_flag": false,
              "required": false,
              "value_name": "AFTER"
            },
            {
              "default": "200",
              "flags": "--limit",
              "is_flag": false,
              "required": false,
              "value_name": "LIMIT"
            },
            {
              "flags": "--database-only",
              "help": "Skip filesystem discovery when a separate resumable file walk is used",
              "is_flag": true,
              "required": false
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings hold-list [--after] [--limit] [--database-only] [-h]"
        },
        {
          "about": "Stream raw local meeting history as NDJSON for encrypted preservation",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "anarlog meetings hold-export",
          "options": [
            {
              "flags": "--database-only",
              "help": "Archive database history only; recording files must be preserved separately",
              "is_flag": true,
              "required": false
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings hold-export [--database-only] [-h] <id>"
        },
        {
          "about": "Describe managed capture capabilities without opening a database",
          "name": "anarlog meetings capabilities",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings capabilities [-h]"
        },
        {
          "about": "Prepare the local database using an existing managed settings policy",
          "name": "anarlog meetings initialize-managed",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings initialize-managed [-h]"
        },
        {
          "about": "Permanently remove an exact, completed local meeting and its recordings",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "anarlog meetings delete",
          "options": [
            {
              "flags": "--if-export-sha256",
              "is_flag": false,
              "required": true,
              "value_name": "IF_EXPORT_SHA256"
            },
            {
              "flags": "--require-transcription-complete",
              "is_flag": true,
              "required": true
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings delete <--if-export-sha256> <--require-transcription-complete> [-h] <id>"
        },
        {
          "about": "List meetings, optionally filtered by text, recurring series, or folder",
          "name": "anarlog meetings list",
          "options": [
            {
              "flags": "-q, --query",
              "is_flag": false,
              "required": false,
              "value_name": "QUERY"
            },
            {
              "flags": "--series-id",
              "is_flag": false,
              "required": false,
              "value_name": "SERIES_ID"
            },
            {
              "flags": "--folder",
              "help": "Folder path, including its subfolders (local source only)",
              "is_flag": false,
              "required": false,
              "value_name": "PATH"
            },
            {
              "default": "20",
              "flags": "--limit",
              "help": "Maximum results (1-200)",
              "is_flag": false,
              "required": false,
              "value_name": "LIMIT"
            },
            {
              "default": "0",
              "flags": "--offset",
              "help": "Number of results to skip",
              "is_flag": false,
              "required": false,
              "value_name": "OFFSET"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings list [-q] [--series-id] [--folder] [--limit] [--offset] [-h]"
        },
        {
          "about": "List meeting folders, including empty and parent folders (local source only)",
          "name": "anarlog meetings folders",
          "options": [
            {
              "flags": "-q, --query",
              "help": "Case-insensitive folder path substring",
              "is_flag": false,
              "required": false,
              "value_name": "QUERY"
            },
            {
              "default": "100",
              "flags": "--limit",
              "help": "Maximum results (1-200)",
              "is_flag": false,
              "required": false,
              "value_name": "LIMIT"
            },
            {
              "default": "0",
              "flags": "--offset",
              "help": "Number of results to skip",
              "is_flag": false,
              "required": false,
              "value_name": "OFFSET"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings folders [-q] [--limit] [--offset] [-h]"
        },
        {
          "about": "Show meeting metadata, notes, summaries, people, and action items",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "anarlog meetings get",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings get [-h] <id>"
        },
        {
          "about": "Show the note or generated summaries for a meeting",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "anarlog meetings note",
          "options": [
            {
              "default": "note",
              "flags": "--kind",
              "is_flag": false,
              "possible_values": [
                "note",
                "summary",
                "all"
              ],
              "required": false,
              "value_name": "KIND"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings note [--kind] [-h] <id>"
        },
        {
          "about": "Show a bounded page of a meeting transcript",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "anarlog meetings transcript",
          "options": [
            {
              "default": "200",
              "flags": "--limit",
              "help": "Maximum transcript words (1-500)",
              "is_flag": false,
              "required": false,
              "value_name": "LIMIT"
            },
            {
              "default": "0",
              "flags": "--offset",
              "help": "Word offset",
              "is_flag": false,
              "required": false,
              "value_name": "OFFSET"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings transcript [--limit] [--offset] [-h] <id>"
        },
        {
          "about": "List meetings from the same recurring series",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "anarlog meetings history",
          "options": [
            {
              "default": "20",
              "flags": "--limit",
              "help": "Maximum meetings (1-200)",
              "is_flag": false,
              "required": false,
              "value_name": "LIMIT"
            },
            {
              "default": "0",
              "flags": "--offset",
              "help": "Number of meetings to skip",
              "is_flag": false,
              "required": false,
              "value_name": "OFFSET"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings history [--limit] [--offset] [-h] <id>"
        },
        {
          "about": "Export a meeting to Markdown or JSON",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "anarlog meetings export",
          "options": [
            {
              "default": "markdown",
              "flags": "--format",
              "is_flag": false,
              "possible_values": [
                "markdown",
                "json"
              ],
              "required": false,
              "value_name": "FORMAT"
            },
            {
              "flags": "-o, --output",
              "is_flag": false,
              "required": false,
              "value_name": "FILE"
            },
            {
              "flags": "--force",
              "help": "Replace an existing output file",
              "is_flag": true,
              "required": false
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog meetings export [--format] [-o] [--force] [-h] <id>"
        }
      ],
      "synopsis": "anarlog meetings [--source] [-h] <command>"
    },
    {
      "about": "Propose meeting edits for desktop review",
      "name": "anarlog proposals",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "subcommands": [
        {
          "about": "Stage a summary or memo replacement for desktop review",
          "name": "anarlog proposals create",
          "options": [
            {
              "flags": "--meeting",
              "is_flag": false,
              "required": true,
              "value_name": "MEETING_ID"
            },
            {
              "flags": "--kind",
              "is_flag": false,
              "possible_values": [
                "summary",
                "memo"
              ],
              "required": true,
              "value_name": "KIND"
            },
            {
              "flags": "--target",
              "is_flag": false,
              "required": false,
              "value_name": "TARGET_ID"
            },
            {
              "flags": "--content",
              "is_flag": false,
              "required": false,
              "value_name": "CONTENT"
            },
            {
              "flags": "--content-file",
              "is_flag": false,
              "required": false,
              "value_name": "FILE"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog proposals create <--meeting> <--kind> [--target] [--content] [--content-file] [-h]"
        },
        {
          "about": "List staged meeting proposals",
          "name": "anarlog proposals list",
          "options": [
            {
              "flags": "--meeting",
              "is_flag": false,
              "required": false,
              "value_name": "MEETING_ID"
            },
            {
              "flags": "--status",
              "is_flag": false,
              "required": false,
              "value_name": "STATUS"
            },
            {
              "default": "20",
              "flags": "--limit",
              "help": "Maximum results (1-200)",
              "is_flag": false,
              "required": false,
              "value_name": "LIMIT"
            },
            {
              "default": "0",
              "flags": "--offset",
              "help": "Number of results to skip",
              "is_flag": false,
              "required": false,
              "value_name": "OFFSET"
            },
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog proposals list [--meeting] [--status] [--limit] [--offset] [-h]"
        },
        {
          "about": "Show one proposal and its unified diff",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "anarlog proposals show",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog proposals show [-h] <id>"
        },
        {
          "about": "Decline a pending proposal without changing the meeting",
          "arguments": [
            {
              "name": "ID",
              "required": true
            }
          ],
          "name": "anarlog proposals decline",
          "options": [
            {
              "flags": "-h, --help",
              "help": "Print help",
              "is_flag": false,
              "required": false
            }
          ],
          "synopsis": "anarlog proposals decline [-h] <id>"
        }
      ],
      "synopsis": "anarlog proposals [-h] <command>"
    },
    {
      "about": "Run the Anarlog MCP server over stdio",
      "name": "anarlog mcp",
      "options": [
        {
          "flags": "-h, --help",
          "help": "Print help",
          "is_flag": false,
          "required": false
        }
      ],
      "synopsis": "anarlog mcp [-h]"
    }
  ],
  "synopsis": "anarlog [--base] [--db-path] [--json] [-h] [-V] <command>"
