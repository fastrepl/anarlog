    "@supabase/supabase-js": "^2.103.0",
    "expo": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
