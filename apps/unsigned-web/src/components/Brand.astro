---
interface Props {
  stagger?: number;
}

const { stagger } = Astro.props;
---

<div class:list={[stagger && `stagger-${stagger}`, "mb-6 flex items-center gap-3"]}>
  <img src="/icon.svg" alt="unsigned char" class="h-7 w-7" />
  <span class="text-[11px] uppercase tracking-[0.32em] text-neutral-500">unsigned-char</span>
</div>
