---
interface Props {
  href: string;
  label: string;
  meta?: string;
}

const { href, label, meta } = Astro.props;
---

<section class="my-8">
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class="group block overflow-hidden rounded-lg border border-neutral-800 bg-neutral-900/80 transition-colors hover:border-neutral-700"
  >
    <div class="flex items-center gap-1.5 border-b border-neutral-800/50 px-4 py-2.5">
      <span class="h-[9px] w-[9px] rounded-full bg-neutral-800 transition-colors group-hover:bg-[#ff5f57]"></span>
      <span class="h-[9px] w-[9px] rounded-full bg-neutral-800 transition-colors group-hover:bg-[#febc2e]"></span>
      <span class="h-[9px] w-[9px] rounded-full bg-neutral-800 transition-colors group-hover:bg-[#28c840]"></span>
    </div>
    <div class="flex items-center gap-4 px-5 py-4">
      <span class="min-w-0 flex-1 overflow-x-auto text-sm">
        <span class="whitespace-nowrap">
          <span class="text-neutral-600">open</span>
          <span class="ml-2 text-neutral-300">{href}</span>
        </span>
      </span>
      <span class="shrink-0 text-[11px] uppercase tracking-[0.2em] text-neutral-700 transition-colors group-hover:text-neutral-500">
        {label}
      </span>
    </div>
  </a>
  {meta && <p class="mt-2 text-center text-xs text-neutral-600">{meta}</p>}
</section>
