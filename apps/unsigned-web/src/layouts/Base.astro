---
import "../styles.css";
import { SEO } from "astro-seo";

const title = "Unsigned Char";
const description =
  "Unsigned Char is a simple download page for the fastrepl/unsigned-char project.";
const url = "https://unsigned.char.com";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <SEO title={title} description={description} canonical={url} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif&display=swap"
      rel="stylesheet"
    />
    <style>html { background: #0a0a0a }</style>
  </head>
  <body>
    <main
      class="mx-auto flex min-h-screen w-full max-w-6xl items-center justify-center bg-neutral-950 px-6 py-12 font-mono text-neutral-100 sm:px-10"
    >
      <slot />
    </main>
  </body>
</html>
