---
import "../styles.css";
import { SEO } from "astro-seo";

const title = "Unsigned Char";
const description =
  "Unsigned Char is a small landing page for the fastrepl/unsigned-char repository.";
const url = "https://unsigned.char.com";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <SEO title={title} description={description} canonical={url} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif&display=swap"
      rel="stylesheet"
    />
    <style>html { background: #0a0a0a }</style>
  </head>
  <body>
    <div class="min-h-screen bg-neutral-950 font-mono text-neutral-100">
      <a
        href="https://github.com/fastrepl/unsigned-char"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full border-b border-neutral-800 bg-neutral-900 py-2 text-center text-sm text-neutral-400 underline transition-colors hover:text-neutral-200"
      >
        View fastrepl/unsigned-char on GitHub &rarr;
      </a>
      <main class="mx-auto max-w-3xl px-6 py-20 sm:py-28">
        <slot />
      </main>
    </div>
  </body>
</html>
