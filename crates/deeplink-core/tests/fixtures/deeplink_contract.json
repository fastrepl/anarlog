  {
    "name": "malformed URL",
    "url": "anarlog://%zz",
    "expect": { "kind": "invalid", "redacted": "anarlog://%zz" }
  },
  {
    "name": "unknown path",
    "url": "anarlog://unknown/path",
    "expect": { "kind": "invalid", "redacted": "anarlog://unknown/path" }
  },
  {
    "name": "non URL string",
    "url": "not a url",
    "expect": { "kind": "invalid", "redacted": "[invalid_url]" }
  },
  {
    "name": "HTTP callback remains a deep link",
    "url": "http://auth/callback?code=http-code",
    "expect": { "kind": "deep_link", "path": "/auth/callback", "redacted": "http://auth/callback" }
  },
  {
    "name": "share open with bad UUID",
    "url": "anarlog://share/open?mode=account&share_id=not-a-uuid",
    "expect": { "kind": "invalid", "redacted": "anarlog://share/open" }
  },
  {
    "name": "sensitive auth query is redacted",
    "url": "anarlog-dev://auth/callback?access_token=secret-access&refresh_token=secret-refresh&code=secret-code&state=state",
    "expect": { "kind": "deep_link", "path": "/auth/callback", "redacted": "anarlog-dev://auth/callback" }
  }
