+static long network_curl_timeout_from_env(const char *name, long fallback) {
+    const char *value = getenv(name);
+    if (!value || !value[0]) return fallback;
+
+    char *end = NULL;
+    long timeout = strtol(value, &end, 10);
+    if (!end || *end != '\0' || timeout <= 0 || timeout > fallback) return fallback;
+    return timeout;
+}
+
+static bool network_curl_apply_options(CURL *curl, network_data *data) {
+    long request_timeout = network_curl_timeout_from_env(
+        "CLOUDSYNC_CURL_TIMEOUT_MS",
+        CLOUDSYNC_CURL_TIMEOUT_MS);
+    long connect_timeout = network_curl_timeout_from_env(
+        "CLOUDSYNC_CURL_CONNECT_TIMEOUT_MS",
+        CLOUDSYNC_CURL_CONNECT_TIMEOUT_MS);
+    if (connect_timeout > request_timeout) connect_timeout = request_timeout;
+
+    return curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L) == CURLE_OK &&
+           curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT_MS, connect_timeout) == CURLE_OK &&
+           curl_easy_setopt(curl, CURLOPT_TIMEOUT_MS, request_timeout) == CURLE_OK &&
+           curl_easy_setopt(curl, CURLOPT_NOPROGRESS, 0L) == CURLE_OK &&
+           curl_easy_setopt(curl, CURLOPT_XFERINFOFUNCTION, network_curl_progress_callback) == CURLE_OK &&
+           curl_easy_setopt(curl, CURLOPT_XFERINFODATA, data) == CURLE_OK;
+}
